<section class="flex min-h-screen items-center bg-light px-4 pb-16 pt-32 text-dark" aria-labelledby="login-heading">
  <div class="mx-auto w-full max-w-sm border-t border-primary pt-6">
    <h1 id="login-heading" class="font-serif text-3xl leading-tight">Iniciar sesión</h1>
    <p class="mt-3 text-sm leading-relaxed text-muted">Accede a la administración de la tienda, la obra, las salas de Exhibit, las exposiciones y los mensajes.</p>

    <p :if={@error} id="login-error" role="alert" class="mt-6 border border-accent bg-accent/10 p-3 text-sm font-semibold text-dark">
      {@error} Revisa tus datos e inténtalo de nuevo.
    </p>

    <.form for={@form} id="login-form" action={~p"/admin/login"} method="post" class="mt-6 space-y-5">
      <div>
        <label for="user_email" class="mb-2 block text-sm font-semibold">Correo electrónico</label>
        <input
          id="user_email"
          name={@form[:email].name}
          value={@form[:email].value}
          type="email"
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          required
          maxlength="254"
          aria-invalid={if @error, do: "true", else: "false"}
          aria-describedby={if @error, do: "login-error"}
          class="min-h-11 w-full rounded-none border border-muted bg-white px-3 py-2 text-base text-dark caret-dark selection:bg-secondary focus:border-dark focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-dark"
        />
      </div>
      <div>
        <label for="user_password" class="mb-2 block text-sm font-semibold">Contraseña</label>
        <input
          id="user_password"
          name="user[password]"
          type="password"
          autocomplete="current-password"
          required
          aria-invalid={if @error, do: "true", else: "false"}
          aria-describedby={if @error, do: "login-error"}
          class="min-h-11 w-full rounded-none border border-muted bg-white px-3 py-2 text-base text-dark caret-dark selection:bg-secondary focus:border-dark focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-dark"
        />
      </div>
      <button type="submit" class="min-h-11 w-full border border-primary bg-primary px-6 py-3 text-sm font-semibold text-dark transition hover:border-accent hover:bg-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dark">
        Iniciar sesión
      </button>
    </.form>
    <a href={~p"/"} class="mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-dark underline decoration-primary decoration-2 underline-offset-4 hover:decoration-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dark">
      Volver al sitio
    </a>
  </div>
</section>
