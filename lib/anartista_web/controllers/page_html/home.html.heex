<section :if={@featured_piece} class="relative isolate overflow-hidden bg-dark px-4 pb-16 pt-28 text-light sm:pb-20 sm:pt-36">
  <div class="mosaic-container opacity-35" id="mosaic-animation" data-background-src={~p"/images/background.webp"}></div>
  <div class="relative z-10 mx-auto max-w-6xl">
    <.featured_piece piece={@featured_piece} />
  </div>
</section>

<section :if={!@featured_piece} class="bg-dark px-4 pb-16 pt-32 text-light sm:pb-20">
  <div class="mx-auto max-w-6xl">
    <h1 class="max-w-3xl font-serif text-5xl leading-none sm:text-6xl">Tienda</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-light/85">
      Piezas únicas y artesanía hechas por Ana, organizadas por las categorías reales de su práctica.
    </p>
  </div>
</section>

<section class="bg-light px-4 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <div :if={@pieces_by_category != []} class="border-y border-primary/60 py-5">
      <nav aria-label="Categorías de la tienda">
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          <li :for={{{category, _pieces}, index} <- Enum.with_index(@pieces_by_category)}>
            <a
              href={"#categoria-#{index}"}
              class="font-serif text-xl text-dark underline decoration-primary decoration-2 underline-offset-4 transition hover:decoration-accent focus-visible:decoration-accent"
            >
              {category}
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div :if={@pieces_by_category == []} class="border border-primary/60 bg-white px-6 py-16 text-center shadow-lg">
      <h1 :if={@featured_piece} class="font-serif text-3xl text-dark">Tienda</h1>
      <p class={["font-serif text-3xl text-dark", @featured_piece && "mt-5"]}>No hay piezas publicadas en este momento.</p>
      <a href="/about" class="mt-8 inline-flex min-h-11 items-center bg-primary px-6 py-2 font-semibold text-dark no-underline transition hover:bg-accent focus-visible:bg-accent">
        Conocer a Ana
      </a>
    </div>

    <div :if={@pieces_by_category != []} class="space-y-16 pt-16 sm:space-y-20 sm:pt-20">
      <section
        :for={{{category, pieces}, index} <- Enum.with_index(@pieces_by_category)}
        id={"categoria-#{index}"}
        class="scroll-mt-28"
      >
        <h2 class="border-b border-primary/60 pb-4 font-serif text-4xl leading-none text-dark sm:text-5xl">{category}</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <.piece_card :for={piece <- pieces} piece={piece} />
        </div>
      </section>
    </div>
  </div>
</section>

<section class="bg-accent/20 px-4 py-16 sm:py-20">
  <div class="mx-auto grid max-w-6xl gap-8 border-y border-dark/25 py-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
    <h2 class="font-serif text-4xl leading-none text-dark sm:text-5xl">La obra continúa en el estudio.</h2>
    <div>
      <p class="text-lg leading-relaxed text-dark/85">Conoce la práctica, los materiales y los procesos que atraviesan cada pieza.</p>
      <a href="/about" class="mt-6 inline-flex min-h-11 items-center border-2 border-dark px-6 py-2 font-semibold text-dark no-underline transition hover:border-primary hover:bg-primary focus-visible:border-primary focus-visible:bg-primary">
        Acerca de Ana
      </a>
    </div>
  </div>
</section>
