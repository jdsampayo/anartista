<section class="bg-dark px-4 pb-16 pt-32 text-light sm:pb-20">
  <div class="mx-auto max-w-6xl">
    <h1 class="font-serif text-5xl leading-none sm:text-6xl">Tienda</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-light/80">
      Piezas únicas disponibles y vendidas, reunidas por las categorías de la práctica.
    </p>
  </div>
</section>

<section class="bg-light px-4 py-16 sm:py-20">
  <div :if={@pieces_by_category == []} class="mx-auto max-w-6xl border border-primary/60 bg-white px-6 py-16 text-center shadow-lg">
    <p class="font-serif text-3xl text-dark">No hay piezas publicadas en este momento.</p>
  </div>

  <div :if={@pieces_by_category != []} class="mx-auto max-w-6xl space-y-16 sm:space-y-20">
    <section :for={{category, pieces} <- @pieces_by_category}>
      <h2 class="border-b border-primary/60 pb-4 font-serif text-3xl leading-none text-dark sm:text-4xl">{category}</h2>
      <div class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <.piece_card :for={piece <- pieces} piece={piece} />
      </div>
    </section>
  </div>
</section>