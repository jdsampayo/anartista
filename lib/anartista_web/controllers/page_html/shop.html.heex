<section class="bg-dark px-4 pb-16 pt-32 text-light sm:pb-20">
  <div class="mx-auto max-w-6xl">
    <h1 class="font-serif text-5xl leading-none sm:text-6xl">Tienda</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-light/80">
      Piezas únicas: collares y aretes hechos para acompañar el cuerpo y permanecer en la memoria.
    </p>
  </div>
</section>

<section class="bg-light px-4 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <div :if={@pieces == []} class="border border-primary/60 bg-white px-6 py-16 text-center shadow-lg">
      <p class="font-serif text-3xl text-dark">No hay piezas publicadas en este momento.</p>
    </div>

    <div :if={@pieces != []} class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <.piece_card :for={piece <- @pieces} piece={piece} />
    </div>
  </div>
</section>