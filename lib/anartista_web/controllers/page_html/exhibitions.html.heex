<section class="bg-accent/20 px-4 pb-16 pt-32 sm:pb-20">
  <div class="mx-auto max-w-6xl">
    <h1 class="font-serif text-5xl leading-none text-dark sm:text-6xl">Exposiciones</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-dark/85">Archivo de participaciones, encuentros y contextos donde la obra continúa su conversación.</p>
  </div>
</section>

<section class="bg-light px-4 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <.exhibition_card
      title="Universos Personales: Primera Exposición"
      date="26 de marzo a 28 de abril 2025"
      location="Ciudad de México"
      opening="Inauguración a las 6pm"
      image_name="universos-personales-2025"
      image_alt="Universos Personales: Primera Exposición"
      description="Muestra colectiva de estudiantes de La Esmeralda que exhibe obras de diversas disciplinas en el restaurante La Guarida del Diablo Panzón. Una iniciativa que promovió el talento emergente y la venta directa de obra."
      link_url="https://www.esmeralda.edu.mx/_files/ugd/d50bce_b8566f0fe8154223bf11385f5e01df69.pdf"
      link_text="Ver programa (PDF)"
    />
    <.exhibition_card
      title="Mujeres Creadoras 2025: Cuidados"
      date="22 y 23 de marzo 2025"
      location="Ciudad de México"
      opening="Inicia a las 9am"
      image_name="mujeres-creadoras-2025"
      image_alt="Mujeres Creadoras 2025: Cuidados"
      description="Exposición que abordó los cuidados desde múltiples dimensiones y narrativas: arte, política, encuentro y compartición."
      link_url="https://www.mujerescreadoras.org/"
      link_text="Visitar Mujeres Creadoras"
    />
  </div>
</section>

<section class="bg-dark px-4 py-16 text-light sm:py-20">
  <div class="mx-auto grid max-w-6xl gap-8 border-y border-secondary/50 py-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
    <h2 class="font-serif text-4xl leading-none sm:text-5xl">¿Quieres proponer una colaboración?</h2>
    <a href="/contact" class="inline-flex min-h-11 items-center justify-center bg-primary px-6 py-2 font-semibold text-dark no-underline transition hover:bg-accent focus-visible:bg-accent">Contacto</a>
  </div>
</section>
