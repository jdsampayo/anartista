<header class="bg-light fixed top-0 z-50 w-full border-b border-primary py-4 backdrop-blur-lg bg-opacity-80 sm:py-5">
  <div class="container mx-auto flex items-center justify-between gap-4 px-4">
    <a href="/" class="font-serif text-3xl font-bold text-light no-underline gradient-text sm:text-4xl">
      <span class="text-primary">An</span><span class="split">A</span><span class="text-dark">rtista</span>
    </a>
    <nav class="hidden md:block" aria-label="Navegación principal">
      <ul class="flex">
        <li class="ml-6"><a href="/#about" class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Práctica</a></li>
        <li class="ml-6"><a href="/#art" class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Obra</a></li>
        <li class="ml-6"><a href="/#exhibitions" class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Exposiciones</a></li>
        <li :if={is_list(assigns[:substack_posts]) and assigns[:substack_posts] != []} class="ml-6"><a href="/#writing" class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Escritos</a></li>
        <li class="ml-6"><a href="/#contact" class="inline-flex rounded-sm bg-primary px-3 py-1 text-dark no-underline font-semibold transition duration-300 hover:bg-accent focus-visible:bg-accent">Contacto</a></li>
      </ul>
    </nav>
    <details class="relative md:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center border border-dark px-3 font-medium text-dark transition hover:border-primary hover:bg-primary focus-visible:border-primary focus-visible:bg-primary [&::-webkit-details-marker]:hidden" aria-label="Abrir navegación">
        <span aria-hidden="true">Menú</span>
      </summary>
      <nav class="absolute right-0 mt-3 w-64 border border-primary bg-light p-2 shadow-lg" aria-label="Navegación móvil">
        <ul class="space-y-1">
          <li><a href="/#about" class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Práctica</a></li>
          <li><a href="/#art" class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Obra</a></li>
          <li><a href="/#exhibitions" class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Exposiciones</a></li>
          <li :if={is_list(assigns[:substack_posts]) and assigns[:substack_posts] != []}><a href="/#writing" class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Escritos</a></li>
          <li><a href="/#contact" class="block min-h-11 bg-primary px-3 py-2 font-semibold text-dark no-underline transition hover:bg-accent focus-visible:bg-accent">Contacto</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<main>
  <%= @inner_content %>
</main>

<footer class="bg-dark text-light py-8 text-center">
  <div class="container mx-auto px-4">
    <p class="mb-5">© {DateTime.utc_now.year} Anartista. Todos los derechos reservados.</p>
    <div class="flex justify-center gap-5 mb-5">
      <a href="https://www.instagram.com/apalvarezvega" class="text-light transition duration-300 hover:text-secondary" aria-label="Checkout my Instagram">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </a>
    </div>
  </div>
</footer>