<% navigation_mode = if assigns[:public_page], do: :patch, else: :navigate %>
<header :if={assigns[:live_action] != :exhibit} class="bg-light fixed top-0 z-50 w-full border-b border-primary py-4 backdrop-blur-lg bg-opacity-80 sm:py-5">
  <div class="container mx-auto flex items-center justify-between gap-4 px-4">
    <.link {%{navigation_mode => ~p"/"}} class="font-serif text-3xl font-bold text-light no-underline gradient-text sm:text-4xl">
      <span class="text-primary">An</span><span class="split">A</span><span class="text-dark">rtista</span>
    </.link>
    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex">
        <li class="ml-6"><.link {%{navigation_mode => ~p"/"}} class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Tienda</.link></li>
        <li class="ml-6"><.link {%{navigation_mode => ~p"/about"}} class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Acerca de</.link></li>
        <li class="ml-6"><.link {%{navigation_mode => ~p"/obra"}} class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Obra</.link></li>
        <li class="ml-6"><.link {%{navigation_mode => ~p"/exhibit"}} class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Exhibit</.link></li>
        <li class="ml-6"><.link {%{navigation_mode => ~p"/exhibitions"}} class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Exposiciones</.link></li>
        <li class="ml-6"><.link {%{navigation_mode => ~p"/writing"}} class="inline-flex rounded-sm px-2 py-1 text-dark no-underline font-medium transition duration-300 hover:bg-primary focus-visible:bg-primary">Escritos</.link></li>
        <li class="ml-6"><.link {%{navigation_mode => ~p"/contact"}} class="inline-flex rounded-sm bg-primary px-3 py-1 text-dark no-underline font-semibold transition duration-300 hover:bg-accent focus-visible:bg-accent">Contacto</.link></li>
      </ul>
    </nav>
    <details class="relative lg:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center border border-dark px-3 font-medium text-dark transition hover:border-primary hover:bg-primary focus-visible:border-primary focus-visible:bg-primary [&::-webkit-details-marker]:hidden" aria-label="Abrir navegación">
        <span aria-hidden="true">Menú</span>
      </summary>
      <nav class="absolute right-0 mt-3 w-64 border border-primary bg-light p-2 shadow-lg" aria-label="Navegación móvil">
        <ul class="space-y-1">
          <li><.link {%{navigation_mode => ~p"/"}} class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Tienda</.link></li>
          <li><.link {%{navigation_mode => ~p"/about"}} class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Acerca de</.link></li>
          <li><.link {%{navigation_mode => ~p"/obra"}} class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Obra</.link></li>
          <li><.link {%{navigation_mode => ~p"/exhibit"}} class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Exhibit</.link></li>
          <li><.link {%{navigation_mode => ~p"/exhibitions"}} class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Exposiciones</.link></li>
          <li><.link {%{navigation_mode => ~p"/writing"}} class="block min-h-11 px-3 py-2 font-medium text-dark no-underline transition hover:bg-secondary focus-visible:bg-secondary">Escritos</.link></li>
          <li><.link {%{navigation_mode => ~p"/contact"}} class="block min-h-11 bg-primary px-3 py-2 font-semibold text-dark no-underline transition hover:bg-accent focus-visible:bg-accent">Contacto</.link></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<main>
  <%= @inner_content %>
</main>

<footer :if={assigns[:live_action] != :exhibit} class="bg-dark text-light py-8 text-center">
  <div class="container mx-auto px-4">
    <p class="mb-5">© {DateTime.utc_now.year} Anartista. Todos los derechos reservados.</p>
    <div class="flex justify-center gap-5 mb-5">
      <a href="https://www.instagram.com/apalvarezvega" class="text-light transition duration-300 hover:text-secondary" aria-label="Checkout my Instagram">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </a>
      <a href="https://www.gotrendier.mx/u/apalvarezvega" target="_blank" rel="noopener noreferrer" class="text-light transition duration-300 hover:text-secondary" aria-label="Visitar el bazar de Ana en GoTrendier">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14l-1 12H6L5 8Zm3 0a4 4 0 0 1 8 0" />
        </svg>
      </a>
    </div>
  </div>
</footer>