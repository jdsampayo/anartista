<section class="bg-accent/20 px-4 pb-16 pt-32 sm:pb-20">
  <div class="mx-auto max-w-6xl">
    <h1 class="font-serif text-5xl leading-none text-dark sm:text-6xl">Exposiciones</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-dark/85">Archivo de participaciones, encuentros y contextos donde la obra continúa su conversación.</p>
  </div>
</section>

<section class="bg-light px-4 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <.exhibition_card
      :for={exhibition <- @exhibitions}
      title={exhibition.title}
      subtitle={exhibition.subtitle}
      date={exhibition.date}
      location={exhibition.location}
      opening={exhibition.opening}
      photo={exhibition.photo}
      image_alt={exhibition.image_alt}
      description={exhibition.description}
      link_url={exhibition.link_url}
      link_text={exhibition.link_text}
    />
    <p :if={@exhibitions == []} class="text-muted">Aún no hay exposiciones en el archivo.</p>
  </div>
</section>

<section class="bg-dark px-4 py-16 text-light sm:py-20">
  <div class="mx-auto grid max-w-6xl gap-8 border-y border-secondary/50 py-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
    <h2 class="font-serif text-4xl leading-none sm:text-5xl">¿Quieres proponer una colaboración?</h2>
    <.link patch={~p"/contact"} class="inline-flex min-h-11 items-center justify-center bg-primary px-6 py-2 font-semibold text-dark no-underline transition hover:bg-accent focus-visible:bg-accent">Contacto</.link>
  </div>
</section>
